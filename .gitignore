# env files
.env*
!.env.example

# admin password hash (runtime override)
/content/admin-auth.json

# analytics counters (runtime)
/content/analytics.json

# system metrics history (runtime, last 30m)
/content/metrics-history.json

# DCHost catalog credentials (runtime)
/content/dchost-settings.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded media (keep folder)
/public/uploads/*
!/public/uploads/.gitkeep
